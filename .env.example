# Copia este archivo a `.env` (NO lo commitees). Lo leen `node build` y pm2 en el server.
# Comentarios siempre en su propia línea: `node --env-file` NO quita los que van al final
# de la línea y los deja pegados al valor.

# Puerto de esta app: el mismo en local y en el server (vite.config.ts)
PORT=2020
# Siempre localhost; el proxy reverso (nginx) va delante
HOST=127.0.0.1
# Requerido por SvelteKit para aceptar POST/form-actions en prod. Cámbialo al
# dominio/IP real cuando se despliegue.
ORIGIN=http://localhost:2020
# SQLite (better-sqlite3 + drizzle). Archivo local; en el droplet persiste entre deploys.
DATABASE_URL=./local.db
